profiles {
  // Local development profile using Docker
  local {
    process {
      executor = "local"
      maxForks = 1
      memory = params.max_memory ?: '6GB'
      cpus = params.max_cpus ?: 1
      time = '4h'
    }
    docker.enabled = true
    docker.fixOwnership = true
  }

  // HPC profile using Singularity
  cluster {
    process {
      executor = "slurm"
      queue = "genoa64"
      memory = '8G'
      cpus = '1'
      time = '8h'

      publishDir = [
        path: '/no_backup/rg/ileahy/SecORFsearch/results',
        mode: 'copy'
      ]
    }

    singularity {
      enabled = true
      cacheDir = "/no_backup/rg/ileahy/Mouse_Analysis/singularity_cache"
      autoMounts = true
    }

    conda.enabled = true
  }
}

params {
  species_taxid = '10090'
  species_name = 'Mus musculus'
  output_dir = 'results'
  geneid_param = "${projectDir}/human3iso.param"
  max_cpus = 4
  max_memory = '8GB'
  help = false
}

process {
    container = 'ghcr.io/iseultl/readthrough:latest'

    withLabel : agat {
        container = 'quay.io/biocontainers/agat:1.5.0--pl5321hdfd78af_0'
        }

    withLabel : gffread {
        container = 'quay.io/biocontainers/gffread:0.12.7--h077b44d_6'
        }

    withLabel : splitfasta {
        container = 'quay.io/biocontainers/seqkit:2.10.0--h9ee0642_0'
        }
    
    withLabel : secissearch {
        container = 'maxtico/seblastian:latest'
        }
    
    withLabel : samtools {
        container = 'biocontainers/samtools:v1.9-4-deb_cv1'
    }
}


